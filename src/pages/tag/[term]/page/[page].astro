---
import Base from '../../../../layouts/Base.astro';
import PostList from '../../../../components/PostList.astro';
import ListHead from '../../../../components/ListHead.astro';
import { getSortedPosts, groupByTag } from '../../../../lib/posts';
import { tagPath } from '../../../../config';

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 10;
  const posts = await getSortedPosts();
  const byTag = groupByTag(posts);
  const paths = [];
  for (const [name, list] of byTag) {
    const totalPages = Math.ceil(list.length / POSTS_PER_PAGE);
    for (let page = 2; page <= totalPages; page++) {
      const start = (page - 1) * POSTS_PER_PAGE;
      paths.push({
        params: { term: tagPath(name), page: String(page) },
        props: {
          name,
          posts: list.slice(start, start + POSTS_PER_PAGE),
          current: page,
          totalPages,
        },
      });
    }
  }
  return paths;
}

const { name, posts, current, totalPages } = Astro.props;
const slug = tagPath(name);
---

<Base title={`#${name} · 第 ${current} 页`} wide>
  <ListHead kicker="标签" title={`#${name}`} subtitle={`第 ${current} / ${totalPages} 页`} />
  <PostList
    posts={posts}
    current={current}
    totalPages={totalPages}
    hrefFor={(n) => (n === 1 ? `/tag/${slug}/` : `/tag/${slug}/page/${n}/`)}
  />
</Base>
