---
import Base from '../../../../layouts/Base.astro';
import PostList from '../../../../components/PostList.astro';
import ListHead from '../../../../components/ListHead.astro';
import { getSortedPosts, groupByCategory, categoryNameForSlug } from '../../../../lib/posts';

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 10;
  const posts = await getSortedPosts();
  const byCategory = groupByCategory(posts);
  const paths = [];
  for (const [slug, list] of byCategory) {
    const totalPages = Math.ceil(list.length / POSTS_PER_PAGE);
    for (let page = 2; page <= totalPages; page++) {
      const start = (page - 1) * POSTS_PER_PAGE;
      paths.push({
        params: { term: slug, page: String(page) },
        props: {
          slug,
          posts: list.slice(start, start + POSTS_PER_PAGE),
          current: page,
          totalPages,
        },
      });
    }
  }
  return paths;
}

const { slug, posts, current, totalPages } = Astro.props;
const name = categoryNameForSlug(slug);
---

<Base title={`${name} 分类 · 第 ${current} 页`} wide>
  <ListHead kicker="分类" title={name} subtitle={`第 ${current} / ${totalPages} 页`} />
  <PostList
    posts={posts}
    current={current}
    totalPages={totalPages}
    hrefFor={(n) => (n === 1 ? `/category/${slug}/` : `/category/${slug}/page/${n}/`)}
  />
</Base>
