---
import Base from './Base.astro';
import Giscus from '../components/Giscus.astro';
import HistoricalComments from '../components/HistoricalComments.astro';
import { formatDate } from '../lib/dates';
import { categorySlug, tagPath } from '../lib/posts';
import { SITE } from '../config';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, description, date, updated, categories, tags, cover, url } = post.data;
const category = categories[0] ?? '未分类';
---

<Base
  title={title}
  description={description}
  image={cover || undefined}
  imageAlt={title}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
>
  <article class="post">
    <header class="post-head">
      <div class="post-meta">
        <a class="post-cat" href={`/category/${categorySlug(category)}/`}>{category}</a>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span class="byline">{SITE.author}</span>
      </div>
      <h1 class="post-title">{title}</h1>
      {updated && updated.getTime() !== date.getTime() && (
        <p class="post-updated">修订于 {formatDate(updated)}</p>
      )}
    </header>

    {cover && (
      <figure class="post-cover">
        <img src={cover} alt={title} />
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="post-foot">
        <div class="post-tags">
          {tags.map((tag) => (
            <a class="tag" href={`/tag/${tagPath(tag)}/`}>#{tag}</a>
          ))}
        </div>
      </footer>
    )}
    
    <HistoricalComments url={url} />
    <Giscus />
  </article>

  <nav class="post-nav" aria-label="文章导航">
    {prev ? (
      <a class="post-nav-item prev" href={prev.data.url} rel="prev">
        <span class="label">上一篇</span>
        <span class="title">{prev.data.title}</span>
      </a>
    ) : (
      <span />
    )}
    {next ? (
      <a class="post-nav-item next" href={next.data.url} rel="next">
        <span class="label">下一篇</span>
        <span class="title">{next.data.title}</span>
      </a>
    ) : (
      <span />
    )}
  </nav>
</Base>

<style>
  .post {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .post-head {
    margin-bottom: 2rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .post-cat {
    color: var(--accent);
    font-weight: 600;
    text-transform: none;
  }
  .byline {
    color: var(--muted);
  }
  .post-title {
    margin: 0;
    font-family: var(--serif-cjk);
    font-size: clamp(1.7rem, 5vw, 2.5rem);
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .post-updated {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .post-cover {
    margin: 0 0 2.4rem;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 16px 44px rgba(43, 42, 40, 0.12);
  }
  .post-cover img {
    display: block;
    width: 100%;
  }
  .post-foot {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.82rem;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.28rem 0.8rem;
    transition: all 0.18s ease;
  }
  .tag:hover {
    color: var(--accent-deep);
    border-color: var(--accent);
    text-decoration: none;
  }
  .post-nav {
    max-width: var(--measure);
    margin: 3.5rem auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .post-nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .post-nav-item:hover {
    text-decoration: none;
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .post-nav-item.next {
    text-align: right;
    align-items: flex-end;
  }
  .post-nav-item .label {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .post-nav-item .title {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.55;
  }
  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav-item.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
